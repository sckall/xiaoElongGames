# scripts/deploy.sh 的部署配置模板
# 用法：cp .env.example .env.deploy，填写后运行 scripts/deploy.sh
# 注意：.env.deploy 已被 .gitignore 忽略，不会提交到仓库

# 腾讯云服务器公网 IP 或已解析的域名
TM_HOST=

# SSH 登录用户（轻量服务器常见 ubuntu/root/lighthouse）
TM_USER=ubuntu

# 服务器上的部署目录
TM_PATH=/home/ubuntu/troublemagician

# 对外端口（与 docker-compose.yml 保持一致）
TM_PORT=8080
